program nombre_ordonne;
var R,N,c,d,u:integer;
begin 
	repeat
	writeln('Entrer la valeur de N:');
	readln(N);
	until (N>100) and (N<999);
	c:=N div 100;
	d:=(N div 10)mod 10;
	u:=N div 10;
	if (c<d) and (d<u)then
	 writeln(N,' est bien ordonne')
  else
	 writeln(N,' n_est pas bien ordonne');
end.
